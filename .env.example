# =============================================================================
# 星幕影票全家桶 —— 环境变量模板
# =============================================================================
# 用法：
#     cp .env.example .env
#     把下面所有 CHANGE_ME_* 换成自己的强密码（不要提交 .env 到仓库）
#
# .env 会被 docker compose 自动加载，同时作为 ${VAR} 插值来源。
# 只有 DB_PASSWORD / REDIS_PASSWORD / RABBITMQ_PASSWORD / MYSQL_ROOT_PASSWORD
# 四个是必填（缺失时 compose 会直接报错并提示变量名）。
# =============================================================================

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
DB_NAME=starscreen
DB_USERNAME=starscreen_app
# 应用账号密码：同时用于建账号与注入应用（注意不要含单引号/反斜杠）
DB_PASSWORD=CHANGE_ME_app_password
# 宿主机调试端口。默认 3307，避开本机可能已占用的 3306
MYSQL_HOST_PORT=3307

# ---------------- Redis ----------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST_PORT=6379

# ---------------- RabbitMQ ----------------
RABBITMQ_USERNAME=starscreen
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
# AMQP 端口默认 5673、管理台默认 15673，均避开本机已有的 5672/15672
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673

# ---------------- 应用 ----------------
APP_HOST_PORT=8080
# 构建方式：
#   Dockerfile           容器内用 maven 镜像编译（默认，宿主机无需 JDK/Maven）
#   Dockerfile.prebuilt  复用宿主机 target/*.jar（离线/内网/拉不到 maven 镜像时用）
APP_DOCKERFILE=Dockerfile
# JVM 参数。MaxRAMPercentage 让堆跟随容器内存上限而不是宿主机内存
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
